---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="about-header about-header-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        <div class="about-intro">
          <div class="clearfix">{{ content }}</div>

          <!-- Social (sits below the bio, aligned with the bottom of the image) -->
          {% if page.social %}
            <div class="social">
              <div class="contact-icons">{% include contact-social-links.liquid %}</div>

              <!-- contact-note hidden -->
              {% comment %}
                <div class="contact-note">{{ site.contact_note }}</div>
              {% endcomment %}
            </div>
          {% endif %}
        </div>

        <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="clearfix">{{ content }}</div>

      <!-- Social -->
      {% if page.social %}
        <div class="social">
          <div class="contact-icons">{% include contact-social-links.liquid %}</div>
        </div>
      {% endif %}
    {% endif %}

    <!-- News (temporarily hidden) -->
    {% comment %}
      {% if page.announcements and page.announcements.enabled %}
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
        </h2>
        {% include news.liquid limit=true %}
      {% endif %}
    {% endcomment %}

    <!-- Latest posts (temporarily hidden) -->
    {% comment %}
      {% if page.latest_posts and page.latest_posts.enabled %}
        <h2>
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      {% endif %}
    {% endcomment %}

    <!-- Publications -->
    {% if page.selected_papers %}
      <h2 class="pub-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Education -->
    <h2 class="edu-heading">Education</h2>
    <div class="education">
      <div class="edu-item">
        <div class="edu-logo">
          <img src="{{ '/assets/img/school/umich.png' | relative_url }}" alt="University of Michigan" loading="lazy">
        </div>
        <div class="edu-body">
          <div class="edu-head">
            <span class="edu-school">University of Michigan - Ann Arbor</span>
            <span class="edu-date">2026 (expected) &ndash;</span>
          </div>
          <div class="edu-degree">Ph.D. in Electrical &amp; Computer Engineering</div>
          <div class="edu-aux">Advised by <a href="https://liyueshen.engin.umich.edu/">Liyue Shen</a></div>
        </div>
      </div>

      <div class="edu-item">
        <div class="edu-logo">
          <img src="{{ '/assets/img/school/kaist.png' | relative_url }}" alt="KAIST" loading="lazy">
        </div>
        <div class="edu-body">
          <div class="edu-head">
            <span class="edu-school">Korea Advanced Institute of Science and Technology (KAIST)</span>
            <span class="edu-date">2024 &ndash; 2026</span>
          </div>
          <div class="edu-degree">M.S. in Artificial Intelligence</div>
          <div class="edu-aux">Advised by <a href="https://mhsung.github.io/">Minhyuk Sung</a></div>
        </div>
      </div>

      <div class="edu-item">
        <div class="edu-logo">
          <img src="{{ '/assets/img/school/sogang.png' | relative_url }}" alt="Sogang University" loading="lazy">
        </div>
        <div class="edu-body">
          <div class="edu-head">
            <span class="edu-school">Sogang University</span>
            <span class="edu-date">2017 &ndash; 2024</span>
          </div>
          <div class="edu-degree">B.S. in Physics &middot; B.S. in Computer Science and Engineering</div>
          <div class="edu-aux">Valedictorian, College of Natural Sciences</div>
        </div>
      </div>
    </div>

    <!-- Social moved into the about-header intro column (see above) -->

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
