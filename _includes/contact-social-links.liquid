{%- assign socials = site.data.socials -%}
{%- if socials.cv_pdf or socials.email or socials.semanticscholar_id or socials.scholar_userid or socials.github_username -%}
  {%- if socials.cv_pdf -%}
    <a href="{{ socials.cv_pdf | relative_url }}" target="_blank" rel="noopener" title="Curriculum Vitae" aria-label="Curriculum Vitae">
      <i class="ai ai-cv"></i>
    </a>
  {%- endif -%}

  {%- if socials.email -%}
    <a href="mailto:{{ socials.email }}" title="Email" aria-label="Email">
      <i class="fa-solid fa-envelope"></i>
    </a>
  {%- endif -%}

  {%- if socials.semanticscholar_id -%}
    <a href="https://www.semanticscholar.org/author/{{ socials.semanticscholar_id }}" target="_blank" rel="noopener" title="Semantic Scholar" aria-label="Semantic Scholar">
      <i class="ai ai-semantic-scholar"></i>
    </a>
  {%- endif -%}

  {%- if socials.scholar_userid -%}
    <a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar">
      <i class="ai ai-google-scholar"></i>
    </a>
  {%- endif -%}

  {%- if socials.github_username -%}
    <a href="https://github.com/{{ socials.github_username }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
      <i class="fa-brands fa-github"></i>
    </a>
  {%- endif -%}
{%- endif -%}
